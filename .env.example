# ── Copy to .env.local for local dev. NEVER commit the filled-in file. ──
# On Vercel these are set in Project → Settings → Environment Variables,
# and DATABASE_URL is injected automatically when you connect Neon.

# Neon Postgres connection string (pooled connection recommended)
DATABASE_URL="postgres://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# 공공데이터포털 특일 정보 서비스키 (한국천문연구원_특일 정보)
# data.go.kr → 활용신청 → 마이페이지에서 발급. 서버에서만 사용, 프론트에 절대 노출 금지.
DATA_GO_KR_KEY="your-service-key-decoded"

# Public base URL used when building share links (optional).
# On Vercel, VERCEL_URL is provided automatically; set this to your custom domain in prod.
# NEXT_PUBLIC_BASE_URL="https://shareday.app"
