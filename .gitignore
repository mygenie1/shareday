# dependencies
/node_modules

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files — NEVER commit real secrets
.env
.env*.local
.env.development
.env.production

# signing material — Codemagic injects these from its secure env at build time
*.jks
*.keystore
keystore.properties

# typescript
*.tsbuildinfo
next-env.d.ts

# original Claude Design export (kept out of the app build)
셰어데이 캘린더.html

# the native app shell — a generated copy of the markup/css/js (npm run build:shell).
# kept out of git so it can never drift from the sources it is copied from; CI and
# `npm run cap:sync` regenerate it before every `cap sync`.
/capacitor-www/

# capacitor native build artifacts (the ios/ and android/ project files ARE committed
# after `npx cap add`; only generated build output + local machine files are ignored)
/ios/App/Pods/
/ios/App/App/public/
/ios/App/build/
/ios/DerivedData/
/android/.gradle/
/android/build/
/android/app/build/
/android/app/src/main/assets/public/
/android/local.properties
/android/.idea/
/android/captures/
.env.capacitor
