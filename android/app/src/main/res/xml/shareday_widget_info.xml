<?xml version="1.0" encoding="utf-8"?>
<!-- res/xml/shareday_widget_info.xml — updatePeriodMillis is battery-friendly
     (~30m is the OS minimum; the app also nudges updates on config change, and you
     can add a periodic WorkManager job for tighter refresh if needed). -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="140dp"
    android:minHeight="110dp"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/shareday_widget"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:previewImage="@drawable/widget_bg" />
