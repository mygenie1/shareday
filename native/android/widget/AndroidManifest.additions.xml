<!--
  Merge these into android/app/src/main/AndroidManifest.xml
  (INSIDE the <application> element, except the deep-link intent-filter which goes
  inside the existing MainActivity <activity>).
-->

<!-- 1) Widget receiver — add inside <application> ... </application> -->
<receiver
    android:name="com.shareday.app.ShareDayWidgetProvider"
    android:exported="false">
    <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
        <action android:name="com.shareday.app.WIDGET_CYCLE" />
    </intent-filter>
    <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/shareday_widget_info" />
</receiver>

<!-- 2) Deep-link for the widget tap (shareday://calendar) — add INSIDE the existing
        MainActivity <activity ...> block. Keep the launcher intent-filter as-is. -->
